---
import { t, setDefaultNamespace, changeLanguage } from "i18next";
import Layout from "../../../layouts/Layout.astro";
import CaseStudyLayout from "../../../layouts/CaseStudyLayout.astro";
import CaseStudySection from "../../../components/case-studies/CaseStudySection.astro";
import CaseStudyContainer from "../../../components/case-studies/CaseStudyContainer.astro";
import Subtitle from "../../../components/ui/Subtitle.astro";
import Bullet from "../../../components/ui/Bullet.astro";

changeLanguage("en");

setDefaultNamespace("unicornioDark");
const unicornioDarkData = {
    colorText: "Unicornio Dark",
    plainText: "VSCode Theme",
    altText: "Unicornio Dark Hero Image",
    imagePath: "/src/assets/cases/hero-unicorniodark.png",
    repository: "https://github.com/unicorniodev/unicornio-dark-theme",
    deploy: "https://marketplace.visualstudio.com/items?itemName=unicorniodev.unicornio-dark",
};
const techBulletsAux = [1, 2, 3];
---

<Layout title={t("site.title")} description={t("layout:site.description")}>
  <CaseStudyLayout workType="Frontend" {...unicornioDarkData}>
    <CaseStudyContainer>
      <CaseStudySection sectionId="introduction">
        <Subtitle title={t("caseStudy:introduction")} />
        <p>{t("project.description.text1")}</p>
      </CaseStudySection>

      <CaseStudySection sectionId="role">
        <Subtitle title={t("caseStudy:role")} />
        <p>
          <span class="text-pink-400 me-3 ms-4">-</span>{
            t("project.role.text1")
          }
        </p>
      </CaseStudySection>

      <CaseStudySection sectionId="stack">
        <Subtitle title={t("caseStudy:stack")} />
        <p>{t("project.stack.description")}</p>
        <ul class="flex flex-col gap-3 ms-4 mt-3">
          {
            techBulletsAux.map((bullet) => (
              <Bullet order={bullet}>
                <p>{t(`project.stack.list.text${bullet}`)}</p>
              </Bullet>
            ))
          }
        </ul>
      </CaseStudySection>

      <CaseStudySection sectionId="spotlight">
        <Subtitle title={t("caseStudy:spotlight")} />
        <p>{t("project.spotlight.text1")}</p>
      </CaseStudySection>

      <CaseStudySection sectionId="lessons">
        <Subtitle title={t("caseStudy:lessons")} />
        <p>{t("project.lessons.text1")}</p>
      </CaseStudySection>
    </CaseStudyContainer>
  </CaseStudyLayout>
</Layout>
