---
import { localizePath } from "astro-i18next";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  imagePath: string;
  altText: string;
  title: string;
  redirectPath: string;
}

const { imagePath, altText, title, redirectPath } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/home/*.{jpeg,jpg,png,gif}",
);

if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/home/*.{jpeg,jpg,png,gif}"`,
  );
---

<a href={localizePath(redirectPath)} class="flex flex-col gap-3">
  <Image src={images[imagePath]()} alt={altText} />
  <div class="flex gap-2 items-center">
    <p>{title}</p>
    <Icon name="arrow-right" size={24} />
  </div>
</a>
