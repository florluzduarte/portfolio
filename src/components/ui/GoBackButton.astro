---
import { Icon } from "astro-icon/components";
import { t, setDefaultNamespace } from "i18next";

setDefaultNamespace("layout");
---

<a
  href="/"
  class="flex items-center gap-2 underline underline-offset-4 hover:text-pink-400"
>
