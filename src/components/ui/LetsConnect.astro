---
import { Image } from "astro:assets";
import { t, setDefaultNamespace } from "i18next";

import deedee from "../../assets/home/deedee.png";
import ContactPill from "./ContactPill.astro";

setDefaultNamespace("home");
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-14 lg:mb-24">
  <div class="flex flex-col gap-3">
    <h2 class="text-[32px] text-pink-400 font-bold lg:text-[48px]">
      {t("contact.title")}
    </h2>
    <p>{t("contact.description")}</p>
    <ContactPill />
  </div>
  <div class="flex justify-center items-center">
    <Image src={deedee} alt="contact me cat" class="p-4" />
  </div>
</div>
